local function makeButton(name,text,x,y,w,h)

	local b = Instance.new("TextButton")
	b.Name = name
	b.Size = UDim2.fromOffset(w,h)
	b.Position = UDim2.fromOffset(x,y)
	b.BackgroundColor3 = BLACK
	b.BackgroundTransparency = 0.05
	b.Text = text
	b.TextColor3 = WHITE
	b.TextSize = 32
	b.Font = Enum.Font.GothamBlack
	b.AutoButtonColor = false
	b.Parent = dpad

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,12)
	c.Parent = b

	return b
end

local up = makeButton("Up","↑",55,0,65,75)
local left = makeButton("Left","←",0,50,80,65)
local right = makeButton("Right","→",100,50,80,65)
local down = makeButton("Down","↓",55,90,65,75)

--==================================================
-- GERAK
--==================================================

local moving = {
	Up = false,
	Down = false,
	Left = false,
	Right = false
}

local buttons = {
	Up = up,
	Down = down,
	Left = left,
	Right = right
}

local function setMove(name,state)

	moving[name] = state

	local b = buttons[name]

	if b then
		b.BackgroundColor3 =
			state
			and Color3.fromRGB(45,45,45)
			or BLACK
	end
end

for name,b in pairs(buttons) do

	b.InputBegan:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

			setMove(name,true)
		end

	end)

	b.InputEnded:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

			setMove(name,false)
		end

	end)

end

--==================================================
-- PLAYER MOVEMENT
--==================================================

RunService.RenderStepped:Connect(function()

	if not gui.Parent then
		return
	end

	if not controls.Visible then
		return
	end

	local character = player.Character
	if not character then return end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not humanoid then return end

	local direction = Vector3.zero

	if moving.Up then
		direction += Vector3.new(0,0,-1)
	end

	if moving.Down then
		direction += Vector3.new(0,0,1)
	end

	if moving.Left then
		direction += Vector3.new(-1,0,0)
	end

	if moving.Right then
		direction += Vector3.new(1,0,0)
	end

	if direction.Magnitude > 0 then

		local camera = workspace.CurrentCamera
		if not camera then return end

		local forward = Vector3.new(
			camera.CFrame.LookVector.X,
			0,
			camera.CFrame.LookVector.Z
		)

		local rightVector = Vector3.new(
			camera.CFrame.RightVector.X,
			0,
			camera.CFrame.RightVector.Z
		)

		if forward.Magnitude > 0 then
			forward = forward.Unit
		end

		if rightVector.Magnitude > 0 then
			rightVector = rightVector.Unit
		end

		local movement =
			forward * -direction.Z
			+ rightVector * direction.X

		if movement.Magnitude > 0 then
			humanoid:Move(movement.Unit,false)
		end

	else
		humanoid:Move(Vector3.zero,false)
	end

end)

